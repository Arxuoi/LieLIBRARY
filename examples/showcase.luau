local Breeze = require(game.ReplicatedStorage.Breeze)
local window = Breeze:CreateWindow({ Title = "Breeze Glass", Subtitle = "Release showcase", Size = UDim2.fromOffset(760, 520) })
local dashboard = window:AddTab({ Title = "Dashboard", Icon = "home" })
local overview = dashboard:AddSection({ Title = "Overview", Description = "A responsive set of live controls" })
overview:AddParagraph({ Title = "Welcome", Description = "Breeze composes translucent surfaces, restrained motion, and clean typography." })
overview:AddProgressBar({ Title = "Session progress", Default = .72 })
local settings = window:AddTab({ Title = "Settings", Icon = "settings" }):AddSection({ Title = "Experience" })
settings:AddToggle({ Title = "Ambient effects", Flag = "Ambient", Default = true })
settings:AddSlider({ Title = "Intensity", Flag = "Intensity", Min = 0, Max = 1, Increment = .05, Default = .6 })
settings:AddDropdown({ Title = "Preset", Values = { "Balanced", "Quality", "Performance" }, Default = "Balanced" })
settings:AddButton({ Title = "Confirm settings", Callback = function() Breeze:Dialog({ Title = "Apply settings?", Content = "Your choices take effect immediately.", Buttons = { { Title = "Cancel" }, { Title = "Apply", Primary = true, Callback = function() Breeze:Notify({ Title = "Applied", Content = "Settings updated.", Type = "Success" }) end } } }) end })
